APP_PORT=8080

DB_URL=postgres://karvon:karvon_pass@localhost:5432/karvon?sslmode=disable
DB_USER=karvon
DB_PASSWORD=karvon_pass
DB_NAME=karvon

JWT_SECRET=your_super_secret_key_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp Baileys микросервис
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_PORT=3001

# Платежи Rahmat
RAHMAT_MERCHANT_ID=your_merchant_id
RAHMAT_SECRET_KEY=your_secret_key

STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Скрытый статик-админ (вход в админку без OTP: POST /api/v1/admin/login)
ADMIN_LOGIN=superadmin
ADMIN_PASSWORD=change_me_in_production

# Универсальный OTP-код (QA/тест): проходит верификацию для ЛЮБОГО телефона.
# Оставьте пустым в проде, чтобы отключить.
UNIVERSAL_OTP=
