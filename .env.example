APP_PORT=8080

DB_URL=postgres://karvon:karvon_pass@localhost:5432/karvon?sslmode=disable
DB_USER=karvon
DB_PASSWORD=karvon_pass
DB_NAME=karvon

JWT_SECRET=your_super_secret_key_change_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# WhatsApp Baileys микросервис
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_PORT=3001

# Платежи Multicard (Rahmat) — Вариант А: инвойс + редирект на checkout_url
# Sandbox: https://dev-mesh.multicard.uz | Prod: https://mesh.multicard.uz
MULTICARD_BASE_URL=https://dev-mesh.multicard.uz
MULTICARD_APP_ID=rhmt_test
MULTICARD_SECRET=your_multicard_secret
MULTICARD_STORE_ID=6
# ИКПУ и код упаковки из tasnif.soliq.uz (IT-платформенные услуги)
MULTICARD_MXIK=10305001001000000
MULTICARD_PACKAGE_CODE=1514918
# URL, куда Multicard отправляет callback при успешной оплате
MULTICARD_CALLBACK_URL=https://api.karvon.uz/api/v1/payments/webhook
# URL для возврата пользователя после оплаты
MULTICARD_RETURN_URL=https://karvon.uz/payment/result

STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Скрытый статик-админ (вход в админку без OTP: POST /api/v1/admin/login)
ADMIN_LOGIN=superadmin
ADMIN_PASSWORD=change_me_in_production

# Универсальный OTP-код (QA/тест): проходит верификацию для ЛЮБОГО телефона.
# Оставьте пустым в проде, чтобы отключить.
UNIVERSAL_OTP=

# Свой сервер карт (tileserver). Фронт берёт адрес через GET /api/v1/config.
MAP_TILES_URL=https://maps.fan.sarbon.me
